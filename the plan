<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111827">
<title>Pizza Express — 1:25 HM</title>

<style>
:root{
  --bg:#f5f5f3;
  --card:#ffffff;
  --text:#171717;
  --muted:#6b7280;
  --line:#e5e7eb;
  --dark:#111827;
  --soft:#f0f1f2;
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  line-height:1.45;
}

.wrap{
  max-width:1100px;
  margin:auto;
  padding:0 20px;
}

header{
  background:var(--dark);
  color:white;
  padding:38px 0 32px;
}

.brand{
  font-size:14px;
  font-weight:800;
  letter-spacing:.12em;
  text-transform:uppercase;
  opacity:.75;
}

h1{
  font-size:clamp(32px,6vw,58px);
  line-height:1;
  margin:10px 0 14px;
  letter-spacing:-.04em;
}

.subtitle{
  font-size:17px;
  color:#d1d5db;
  max-width:680px;
}

.hero-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
  margin-top:26px;
}

.hero-stat{
  border:1px solid #374151;
  border-radius:14px;
  padding:17px;
  background:#1f2937;
}

.hero-stat strong{
  display:block;
  font-size:25px;
}

.hero-stat span{
  font-size:12px;
  color:#9ca3af;
  text-transform:uppercase;
  letter-spacing:.08em;
}

nav{
  position:sticky;
  top:0;
  z-index:10;
  background:rgba(245,245,243,.96);
  border-bottom:1px solid var(--line);
  backdrop-filter:blur(8px);
}

.nav-inner{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:11px 20px;
  max-width:1100px;
  margin:auto;
}

.nav-inner a{
  white-space:nowrap;
  text-decoration:none;
  font-size:13px;
  font-weight:700;
  padding:8px 11px;
  border-radius:9px;
  background:white;
  border:1px solid var(--line);
}

section{
  padding:34px 0 0;
}

.section-title{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:15px;
  margin-bottom:14px;
}

h2{
  font-size:26px;
  margin:0;
  letter-spacing:-.025em;
}

.week-meta{
  font-size:13px;
  color:var(--muted);
  font-weight:700;
}

.rules{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
}

.rule{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:12px;
  padding:14px;
}

.rule strong{
  display:block;
  font-size:15px;
  margin-bottom:3px;
}

.rule span{
  font-size:12px;
  color:var(--muted);
}

.days{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.day{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:15px;
  padding:17px;
}

.day.key{
  border:2px solid var(--dark);
}

.day-head{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:center;
  margin-bottom:8px;
}

.day-name{
  font-weight:800;
  font-size:15px;
}

.badge{
  font-size:10px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.08em;
  padding:5px 7px;
  border-radius:7px;
  background:var(--dark);
  color:white;
}

.day h3{
  margin:0 0 7px;
  font-size:18px;
  letter-spacing:-.015em;
}

.day p{
  margin:5px 0;
  font-size:14px;
}

.day .details{
  color:#4b5563;
  font-size:13px;
}

.pace{
  font-weight:800;
}

.week-total{
  margin-top:12px;
  background:var(--dark);
  color:white;
  border-radius:12px;
  padding:13px 15px;
  font-size:13px;
  font-weight:700;
}

.note{
  background:#fff;
  border:1px solid var(--line);
  border-radius:14px;
  padding:17px;
  margin-top:28px;
}

footer{
  padding:45px 0 60px;
  color:var(--muted);
  font-size:12px;
}

@media(max-width:720px){

  .wrap{
    padding:0 14px;
  }

  .nav-inner{
    padding-left:14px;
    padding-right:14px;
  }

  .hero-grid,
  .rules,
  .days{
    grid-template-columns:1fr;
  }

  section{
    padding-top:27px;
  }

  .day{
    padding:15px;
  }
}
</style>
</head>

