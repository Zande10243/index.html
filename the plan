<!-- PLAN RULES -->

<section id="rules">

<div class="section-title">
<h2>Plan rules</h2>
</div>

<div class="rules">

<div class="rule">
<strong>≤60 km</strong>
<span>Weekly running maximum</span>
</div>

<div class="rule">
<strong>23–24 km</strong>
<span>Maximum long run</span>
</div>

<div class="rule">
<strong>48–72h</strong>
<span>Between running sessions</span>
</div>

<div class="rule">
<strong>4×4 bike</strong>
<span>Monday VO₂ stimulus</span>
</div>

</div>

<div class="note">

<strong>Weekly rhythm:</strong>

Monday bike + upper strength ·
Tuesday upper + light unilateral legs ·
Wednesday aerobic run ·
Thursday full body + low-volume heavy legs ·
Friday key run ·
Saturday rest/hike ·
Sunday long run.

</div>

</section>



